rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isTutor() { return signedIn() && myProfile().role in ['tutor', 'admin']; }
    function isAdmin() { return signedIn() && myProfile().role == 'admin'; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Parents: users/{uid} with role 'parent' and children = [student uid, ...]
    function isParent() { return signedIn() && myProfile().role == 'parent'; }
    function isParentOf(uid) { return signedIn() && (uid in myProfile().get('children', [])); }

    match /users/{uid} {
      // Users read their own profile; tutors read their own students; admins read everyone
      allow read: if signedIn() && (request.auth.uid == uid || resource.data.tutorId == request.auth.uid || resource.data.parentUid == request.auth.uid || isAdmin());

      // Student accounts are created server-side when HSJ places an applicant
      // into a group (api/students.js, service account, bypasses rules). A
      // profile created from the client (someone signing in who has not been
      // placed) starts as free with no group.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'free'
        && !('classId' in request.resource.data)
        && !('tutorId' in request.resource.data);

      allow update: if signedIn() && (
        // The student's own tutor, or an admin, may set their display name and nothing else
        ((resource.data.tutorId == request.auth.uid || isAdmin()) && changed().hasOnly(['displayName']))
        ||
        // Own profile: may not touch role, group links or onboarding records
        (request.auth.uid == uid
          && !changed().hasAny(['role', 'classId', 'className', 'tutorId', 'parentUid', 'children', 'year', 'parentName', 'parentEmail', 'parentPhone', 'paymentPlan', 'paymentAmount', 'selfEvaluation', 'termsAccepted', 'agreement', 'applicantId', 'placedAt']))
      );
    }

    // Onboarding queue. Written only by the server (api/students.js and
    // api/onboarding.js); admins read it in the Students tab.
    match /applicants/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Invoices and payments mirrored from Stripe by api/stripe-webhook.js.
    // The student (and later their parent), their tutor and admins can read them.
    match /payments/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.tutorId == request.auth.uid || isParentOf(resource.data.uid) || isAdmin());
      allow write: if false;
    }

    // Groups (one tutor each). Tutors see their own; admins see and manage all.
    match /classes/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && (resource.data.tutorId == request.auth.uid || isAdmin());
      allow create: if isTutor()
        && (request.resource.data.tutorId == request.auth.uid || isAdmin())
        && request.resource.data.code == code
        && request.resource.data.name is string;
      allow update, delete: if signedIn() && (resource.data.tutorId == request.auth.uid || isAdmin());
    }

    match /attempts/{id} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || resource.data.tutorId == request.auth.uid || isParentOf(resource.data.uid));
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tutorId == myProfile().get('tutorId', null)
        && request.resource.data.type is string
        && request.resource.data.questionId is string;
      allow update, delete: if false;
    }

    // Reminder de-duplication keys, written only by the cron endpoint
    match /reminders/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Past-paper questions and their per-board index, written only by the admin pipeline
    match /ppq/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /ppqIndex/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    // A student's attempts at past-paper questions (marked server-side)
    match /ppqAttempts/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isTutor() || isParentOf(resource.data.uid));
      allow write: if false;
    }

    // Lessons: one per group per date, written by the tutor
    match /lessons/{id} {
      allow read: if signedIn() && (resource.data.tutorId == request.auth.uid || isAdmin());
      allow create: if isTutor()
        && request.resource.data.tutorId == request.auth.uid
        && request.resource.data.classId is string
        && request.resource.data.date is string;
      allow update, delete: if signedIn() && resource.data.tutorId == request.auth.uid;
    }

    // Lesson notes: one per student per lesson (doc id lessonId_uid). The
    // tutor writes them; the student reads their own; the send endpoint
    // stamps sentAt server-side.
    match /lessonNotes/{id} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || resource.data.tutorId == request.auth.uid || isParentOf(resource.data.uid) || isAdmin());
      allow create: if isTutor()
        && request.resource.data.tutorId == request.auth.uid
        && id == request.resource.data.lessonId + '_' + request.resource.data.uid;
      allow update: if signedIn() && resource.data.tutorId == request.auth.uid
        && !changed().hasAny(['uid', 'tutorId', 'lessonId']);
      allow delete: if signedIn() && resource.data.tutorId == request.auth.uid;
    }

    // Homework set by a tutor for one group
    match /assignments/{id} {
      // The tutor who set it, or a student in that group, can read it
      allow read: if signedIn()
        && (resource.data.tutorId == request.auth.uid || resource.data.classId == myProfile().get('classId', null));
      // Parents read the homework set for their child's group (titles, due dates, items)
      allow get: if isParent();
      allow create: if isTutor()
        && request.resource.data.tutorId == request.auth.uid
        && request.resource.data.classId is string
        && request.resource.data.title is string
        && request.resource.data.items is list;
      allow update, delete: if signedIn() && resource.data.tutorId == request.auth.uid;
    }

    // One submission per student per assignment (doc id: assignmentId_uid)
    match /submissions/{id} {
      // A student's first visit reads a submission that does not exist yet,
      // so a get on a missing doc is allowed when the id ends in their uid
      allow get: if signedIn()
        && (id.matches('.*_' + request.auth.uid) || resource.data.tutorId == request.auth.uid || isParentOf(resource.data.uid));
      allow list: if signedIn()
        && (resource.data.uid == request.auth.uid || resource.data.tutorId == request.auth.uid || isParentOf(resource.data.uid));
      // Student creates their own, for an assignment set to their group
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tutorId == myProfile().get('tutorId', null)
        && id == request.resource.data.assignmentId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId))
        && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.classId == myProfile().get('classId', null);
      // Student saves answers until submitted, and may query a mark at any time;
      // the tutor can adjust marks, add comments and reply to queries
      allow update: if signedIn() && (
        (resource.data.uid == request.auth.uid && resource.data.submittedAt == null
          && !changed().hasAny(['uid', 'tutorId', 'assignmentId', 'classId', 'tutorMarks', 'tutorComment']))
        ||
        (resource.data.uid == request.auth.uid && changed().hasOnly(['queries']))
        ||
        (resource.data.tutorId == request.auth.uid
          && changed().hasOnly(['tutorMarks', 'tutorComment', 'totalScore', 'reviewedAt', 'queries']))
      );
      allow delete: if false;
    }
  }
}
