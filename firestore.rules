rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isTutor() { return signedIn() && myProfile().role in ['tutor', 'admin']; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /users/{uid} {
      // Users can read their own profile; tutors can read their own students
      allow read: if signedIn() && (request.auth.uid == uid || resource.data.tutorId == request.auth.uid);

      // New profiles must start as free — role upgrades come from the
      // Stripe webhook (Admin SDK, bypasses rules) or key redemption below
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'free'
        && !('classId' in request.resource.data)
        && !('tutorId' in request.resource.data);

      allow update: if signedIn() && request.auth.uid == uid
        && (
          // Normal profile updates may not touch role, billing or class links
          !changed().hasAny(['role', 'stripeCustomerId', 'stripeSubscriptionId', 'paidAt', 'classId', 'tutorId'])
          ||
          // Redeeming a key: may set role to access_key only, and only
          // if the named key exists, is enabled, and has not expired
          (
            changed().hasOnly(['role', 'accessKey', 'accessKeyExpiry'])
            && request.resource.data.role == 'access_key'
            && exists(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKey))
            && get(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKey)).data.disabled != true
          )
          ||
          // Joining a class: classId must be a real class and tutorId must be its tutor
          (
            changed().hasOnly(['classId', 'tutorId', 'joinedClassAt'])
            && request.resource.data.classId is string
            && exists(/databases/$(database)/documents/classes/$(request.resource.data.classId))
            && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.tutorId == request.resource.data.tutorId
            && request.resource.data.tutorId != request.auth.uid
          )
          ||
          // Leaving a class
          (
            changed().hasOnly(['classId', 'tutorId', 'joinedClassAt'])
            && request.resource.data.classId == null
            && request.resource.data.tutorId == null
          )
        );
    }

    match /accessKeys/{key} {
      // Signed-in users can look up a key by its exact ID, but never
      // enumerate the collection
      allow get: if signedIn();
      allow list: if false;

      // Redemption only bumps usage tracking; nothing else is writable
      allow update: if signedIn()
        && changed().hasOnly(['usageCount', 'lastUsedAt']);

      // Keys are created/deleted from the Firebase console or Admin SDK only
      allow create, delete: if false;
    }

    match /classes/{code} {
      // Anyone signed in can look up a class by its exact code (to join it);
      // only the owning tutor can list their classes
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.tutorId == request.auth.uid;

      allow create: if isTutor()
        && request.resource.data.tutorId == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.name is string;

      allow update, delete: if signedIn() && resource.data.tutorId == request.auth.uid;
    }

    match /attempts/{id} {
      // A student can read their own attempts; their tutor can read them too
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || resource.data.tutorId == request.auth.uid);

      // Attempts are written by the student, for themselves, and the tutorId
      // must match the tutor they are actually linked to
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tutorId == myProfile().get('tutorId', null)
        && request.resource.data.type is string
        && request.resource.data.questionId is string;

      // Immutable once written
      allow update, delete: if false;
    }
  }
}
